# Copy to .env.local for local dev. On Vercel, set these in Project > Settings >
# Environment Variables.
#
# This app holds NO provider keys. It proxies to the Python backend in api/, which is
# where OPENAI_API_KEY and PINECONE_API_KEY live. Rotating a key never touches this
# deployment, and there is nothing here for a frontend bug to leak.

# Where the backend is running. Leave UNSET on Vercel when the backend is co-deployed
# as api/index.py in this same project — VERCEL_URL is used automatically. Set it only
# when the backend is hosted separately (a container, or another Vercel project).
# Locally: uvicorn rag.main:app --app-dir api --port 8000
BACKEND_URL=http://localhost:8000

# Optional shared secret, sent as X-API-Key. Set it in both places to stop anyone who
# finds the backend URL from calling it directly and bypassing this app's rate limit.
# BACKEND_API_KEY=
