# Copy to .env.local for local dev. On Vercel, set these in Project > Settings > Environment Variables.
#
# This demo uses Pinecone integrated inference: Pinecone hosts the embedding model and
# embeds both the briefs (at ingest) and the user's question (at query time) server-side.
# So the public endpoint needs ONLY a Pinecone key — there is no OpenAI key to leak or cap.

PINECONE_API_KEY=...

# Index is created automatically by `npm run ingest` if it does not exist.
PINECONE_INDEX=clinical-kb

# Matches below this similarity score are treated as "no approved answer" (anti-hallucination).
MIN_SCORE=0.35
