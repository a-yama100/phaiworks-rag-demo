# Copy to api/.env and fill in. This file is the ONLY place provider keys live —
# the Next.js deployment proxies to this service and holds no AI credentials.

PINECONE_API_KEY=...

# Providers are selected by config, not hardcoded. Supply a key for whichever you pick.
#   EMBED_PROVIDER: google | openai
#   CHAT_PROVIDER : google | openai | anthropic
EMBED_PROVIDER=google
CHAT_PROVIDER=google

GOOGLE_API_KEY=...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# The index name encodes the embedding model, because the two cannot be mixed: changing
# the embedding provider changes the vector dimension, so it needs a NEW index rather
# than a re-ingest into the existing one.
#   google / gemini-embedding-001      -> 3072 dims
#   openai / text-embedding-3-small    -> 1536 dims
PINECONE_INDEX=clinical-kb-gemini

# Optional overrides; defaults are in app/settings.py.
# EMBED_MODEL=gemini-embedding-001
# CHAT_MODEL=gemini-2.5-flash
# EMBED_DIM=3072
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
# TOP_K=5
# MIN_SCORE=0.35
# RETRIEVAL_MODE=hybrid
# MAX_REWRITES=1

# Comma-separated. The frontend origin(s) allowed to call this service.
# ALLOWED_ORIGINS=http://localhost:3000,https://rag-demo.phaiworks.com
